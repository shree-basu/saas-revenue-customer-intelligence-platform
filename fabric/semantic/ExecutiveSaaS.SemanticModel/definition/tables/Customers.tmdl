table Customers
	measure 'Current MRR USD' = SUM(Customers[current_mrr_usd])
		formatString: $#,##0.00

	measure 'Current ARR USD' = [Current MRR USD] * 12
		formatString: $#,##0.00

	measure 'At-Risk Accounts' = CALCULATE(DISTINCTCOUNT(Customers[account_id]), Customers[health_status] = "AT_RISK")
		formatString: #,##0

	column account_id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: account_id

	column account_name
		dataType: string
		summarizeBy: none
		sourceColumn: account_name

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column segment
		dataType: string
		summarizeBy: none
		sourceColumn: segment

	column health_status
		dataType: string
		summarizeBy: none
		sourceColumn: health_status

	column reporting_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: reporting_date

	column current_mrr_usd
		dataType: decimal
		summarizeBy: none
		sourceColumn: current_mrr_usd

	column overdue_invoice_count
		dataType: int64
		summarizeBy: none
		sourceColumn: overdue_invoice_count

	partition Customers = m
		mode: import
		source =
			#table(type table [account_id = text, account_name = text, region = text, segment = text, health_status = text, reporting_date = date, current_mrr_usd = number, overdue_invoice_count = Int64.Type], {})
